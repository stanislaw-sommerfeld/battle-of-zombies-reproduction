        {
          "event": "Check",
          "if": {
            "flag": "hush_quieted",
            "eq": "slain"
          },
          "complete": "slain"
        },
        {
          "event": "Check",
          "if": {
            "flag": "hush_quieted",
            "eq": "rites"
          },
          "complete": "rites"
        },
        {
          "event": "Check",
          "if": {
            "flag": "hush_quieted",
            "eq": "named"
          },
          "complete": "named"
        }
      ]
    }
  },
  "outcomes": {
    "slain": {
      "text": "You broke the Bellwarden. The Hush is quiet, though no one was ever counted.",
      "effects": [
        {
          "giveXp": 100
        },
        {
          "faction": "lanternfast",
          "delta": 1
        }
      ]
    },
    "rites": {
